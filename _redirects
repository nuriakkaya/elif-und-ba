# Elif & Ba — Wegweiser für den Klassen-Server.
# Diese Datei ist reine Konfiguration und wird von Netlify AUCH DANN gelesen,
# wenn die Seite ohne Build hochgeladen wird (Drag & Drop). Sie sorgt dafür,
# dass /api/... beim Mini-Server landet, selbst wenn Netlify die moderne
# Routen-Angabe in der Function-Datei nicht auswertet.
/api/*        /.netlify/functions/sync/:splat   200
/media/audio  /.netlify/functions/sync/media/audio   200

# Landingpage zum Installieren (11.0)
/installieren  /installieren.html  200
# Kurze Adressen fuer die Landingpage (14.09.2026): elif-be.de/installieren, /yukle (TR), /start
/yukle         /installieren.html  200
/start         /installieren.html  200
